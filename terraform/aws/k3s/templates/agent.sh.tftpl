#!/bin/bash
# k3s agent bootstrap (Amazon Linux 2023), rendered by Terraform. Runs once, at first boot. The agent keeps
# retrying the server on its own, so it can boot before the server is ready.
# Log: /var/log/storefront-k3s-init.log
set -euo pipefail
exec > >(tee -a /var/log/storefront-k3s-init.log) 2>&1

imds_token=$(curl -sf -X PUT -H "X-aws-ec2-metadata-token-ttl-seconds: 300" http://169.254.169.254/latest/api/token)
zone=$(curl -sf -H "X-aws-ec2-metadata-token: $imds_token" http://169.254.169.254/latest/meta-data/placement/availability-zone)

for _ in $(seq 30); do
  token=$(aws ssm get-parameter --region ${region} --name ${token_param} --with-decryption \
    --query Parameter.Value --output text) && break
  sleep 5
done

# Flags, and why the install is retried, in server.sh.tftpl. Agents get the same eviction thresholds, but no
# reservation: they don't run the control plane.
install_k3s() {
  curl -sfL https://get.k3s.io | \
    INSTALL_K3S_VERSION='${k3s_version}' INSTALL_K3S_SKIP_SELINUX_RPM=true INSTALL_K3S_SELINUX_WARN=true \
    K3S_URL='https://${server_ip}:6443' K3S_TOKEN="$token" sh -s - agent \
      --prefer-bundled-bin \
      --kubelet-arg "eviction-hard=memory.available<300Mi,imagefs.available<5%,nodefs.available<5%" \
      --node-label "topology.kubernetes.io/zone=$zone" \
      --node-label "topology.kubernetes.io/region=${region}"
}
for attempt in 1 2 3 4 5; do
  install_k3s && break
  [ "$attempt" = 5 ] && { echo "k3s install failed 5 times"; exit 1; }
  echo "k3s install failed (attempt $attempt of 5), retrying in 30 s"
  sleep 30
done
echo "k3s agent started in $zone"
