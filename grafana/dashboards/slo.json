{
  "uid": "storefront-slo",
  "title": "Storefront SLOs",
  "tags": [
    "storefront",
    "slo"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "description": "Error budgets and burn rates for the SLOs in docs/slo.md.",
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Pages",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "enable": true,
        "iconColor": "#d03b3b",
        "target": {
          "refId": "Anno",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "ALERTS{alertstate=\"firing\", severity=\"page\", alertname=~\"Storefront.*\"}",
          "interval": "60s"
        },
        "titleFormat": "{{alertname}}",
        "tagKeys": "severity,slo",
        "textFormat": "{{slo}}",
        "useValueForTime": false
      },
      {
        "name": "Tickets",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "enable": true,
        "iconColor": "#fab219",
        "target": {
          "refId": "Anno",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "ALERTS{alertstate=\"firing\", severity=\"ticket\", alertname=~\"Storefront.*\"}",
          "interval": "60s"
        },
        "titleFormat": "{{alertname}}",
        "tagKeys": "severity,slo",
        "textFormat": "{{slo}}",
        "useValueForTime": false
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0
      },
      {
        "name": "window",
        "label": "Budget window",
        "type": "custom",
        "query": "28d,1d",
        "hide": 0,
        "current": {
          "text": "28d",
          "value": "28d"
        },
        "options": [
          {
            "text": "28d",
            "value": "28d",
            "selected": true
          },
          {
            "text": "1d",
            "value": "1d",
            "selected": false
          }
        ]
      },
      {
        "name": "slo",
        "label": "SLO",
        "type": "custom",
        "hide": 0,
        "multi": true,
        "includeAll": true,
        "query": "checkout-availability,checkout-latency,catalog-availability,cart-availability",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**Burn rate** = error ratio ÷ error budget. At **1×** the budget lasts exactly the window; at **14.4×** it's gone in under 2 days. Pages fire when a long *and* a short window both cross the threshold (dashed lines): **1h & 5m > 14.4×** or **6h & 30m > 6×**. Tickets: 1d & 2h > 3× or 3d & 6h > 1×. Red and yellow markers are pages and tickets that fired.  \nUse **Budget window = 1d** in the lab, where 28 days of history never accumulates. Definitions: `docs/slo.md` · alerts: `prometheus/rules/slo-alerts.yml` · runbooks: `docs/runbooks/`"
      }
    },
    {
      "id": 2,
      "type": "row",
      "title": "$slo",
      "repeat": "slo",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 3
      },
      "panels": []
    },
    {
      "id": 3,
      "type": "stat",
      "title": "SLI vs. objective (${window})",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Share of good events over the selected window, next to the target. Plain text: the budget panel carries the status color.",
      "gridPos": {
        "h": 7,
        "w": 5,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "no traffic"
                }
              }
            }
          ],
          "noValue": "no traffic",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "vertical",
        "wideLayout": true,
        "showPercentChange": false
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "1 - {__name__=~\"slo:.+:error_ratio_rate${window}\", slo=\"$slo\"}",
          "legendFormat": "SLI",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "{__name__=~\"slo:.+:objective\", slo=\"$slo\"}",
          "legendFormat": "Objective",
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Error budget remaining (${window})",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "1 − error ratio ÷ (1 − objective). 100% = untouched, 0% = spent, negative = overspent. Below 50% is a warning; below 0 means freeze risky changes.",
      "gridPos": {
        "h": 7,
        "w": 5,
        "x": 5,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "no traffic"
                }
              }
            }
          ],
          "noValue": "no traffic",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#d03b3b",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 0
              },
              {
                "color": "#0ca30c",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "1 - {__name__=~\"slo:.+:error_ratio_rate${window}\", slo=\"$slo\"} / on(slo) (1 - {__name__=~\"slo:.+:objective\", slo=\"$slo\"})",
          "legendFormat": "Budget remaining",
          "range": true
        }
      ]
    },
    {
      "id": 5,
      "type": "bargauge",
      "title": "Burn rate now, by window",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Current burn rate for every recorded window, shortest first. 1× = sustainable. Colors mark the alert thresholds: 1× (ticket, with 3d & 6h), 6× and 14.4× (page).",
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 10,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix:×",
          "decimals": 1,
          "min": 0,
          "max": 15,
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "no traffic"
                }
              }
            }
          ],
          "noValue": "no traffic",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0ca30c",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 1
              },
              {
                "color": "#ec835a",
                "value": 6
              },
              {
                "color": "#d03b3b",
                "value": 14.4
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "basic",
        "valueMode": "text",
        "namePlacement": "left",
        "showUnfilled": true,
        "sizing": "auto",
        "minVizHeight": 10,
        "maxVizHeight": 300
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "{__name__=~\"slo:.+:error_ratio_rate5m\", slo=\"$slo\"} / on(slo) (1 - {__name__=~\"slo:.+:objective\", slo=\"$slo\"})",
          "legendFormat": "5m",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "{__name__=~\"slo:.+:error_ratio_rate30m\", slo=\"$slo\"} / on(slo) (1 - {__name__=~\"slo:.+:objective\", slo=\"$slo\"})",
          "legendFormat": "30m",
          "range": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "{__name__=~\"slo:.+:error_ratio_rate1h\", slo=\"$slo\"} / on(slo) (1 - {__name__=~\"slo:.+:objective\", slo=\"$slo\"})",
          "legendFormat": "1h",
          "range": true
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "{__name__=~\"slo:.+:error_ratio_rate2h\", slo=\"$slo\"} / on(slo) (1 - {__name__=~\"slo:.+:objective\", slo=\"$slo\"})",
          "legendFormat": "2h",
          "range": true
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "{__name__=~\"slo:.+:error_ratio_rate6h\", slo=\"$slo\"} / on(slo) (1 - {__name__=~\"slo:.+:objective\", slo=\"$slo\"})",
          "legendFormat": "6h",
          "range": true
        },
        {
          "refId": "F",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "{__name__=~\"slo:.+:error_ratio_rate1d\", slo=\"$slo\"} / on(slo) (1 - {__name__=~\"slo:.+:objective\", slo=\"$slo\"})",
          "legendFormat": "1d",
          "range": true
        },
        {
          "refId": "G",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "{__name__=~\"slo:.+:error_ratio_rate3d\", slo=\"$slo\"} / on(slo) (1 - {__name__=~\"slo:.+:objective\", slo=\"$slo\"})",
          "legendFormat": "3d",
          "range": true
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Burn rate over time (page windows)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Solid = long window, dashed = short window, same color = same alert pair. A page needs both lines of a pair above its threshold line. After recovery the short line drops first, so the page clears while the long line is still high.",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix:×",
          "decimals": 1,
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "thresholdsStyle": {
              "mode": "dashed"
            },
            "axisSoftMax": 16
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "#ec835a",
                "value": 6
              },
              {
                "color": "#d03b3b",
                "value": 14.4
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "1h (page at 14.4×)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "5m (page at 14.4×)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    6,
                    4
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "6h (page at 6×)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "30m (page at 6×)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    6,
                    4
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "{__name__=~\"slo:.+:error_ratio_rate1h\", slo=\"$slo\"} / on(slo) (1 - {__name__=~\"slo:.+:objective\", slo=\"$slo\"})",
          "legendFormat": "1h (page at 14.4×)",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "{__name__=~\"slo:.+:error_ratio_rate5m\", slo=\"$slo\"} / on(slo) (1 - {__name__=~\"slo:.+:objective\", slo=\"$slo\"})",
          "legendFormat": "5m (page at 14.4×)",
          "range": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "{__name__=~\"slo:.+:error_ratio_rate6h\", slo=\"$slo\"} / on(slo) (1 - {__name__=~\"slo:.+:objective\", slo=\"$slo\"})",
          "legendFormat": "6h (page at 6×)",
          "range": true
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "{__name__=~\"slo:.+:error_ratio_rate30m\", slo=\"$slo\"} / on(slo) (1 - {__name__=~\"slo:.+:objective\", slo=\"$slo\"})",
          "legendFormat": "30m (page at 6×)",
          "range": true
        }
      ]
    }
  ]
}
